#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

// DYA Studio用
#include <input/processors/runtime-input-processor.dtsi>
#include <behaviors/battery_history_request.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>

#define BASE     0
#define MOUSE    1
#define LOWER    2
#define RAISE    3
#define SCROLL   4
#define ADJUST   5

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&trackball_listener {
    input-processors = <
        &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
        &mouse_runtime_input_processor
        &zip_temp_layer MOUSE 500
    >;
    scroller {
        layers = <SCROLL>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
            &zip_xy_scaler 1 20
            &zip_xy_to_scroll_mapper
            &scroll_runtime_input_processor
        >;
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };
};

/ {
    behaviors {
        // ロータリーエンコーダー（DYA Studioから変更可）
        EC11_vol: behavior_ec11_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
            tap-ms = <5>;
        };

        EC11_scroll: behavior_ec11_scroll {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
            tap-ms = <5>;
        };
    };
};

&sl { release-after-ms = <250>; };
/ {
    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog MOUSE &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&EC11_vol>;
            bindings = <
&kp ESC    &kp N1      &kp N2  &kp N3    &kp N4     &kp N5                         &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                   &kp N6  &kp N7  &kp N8     &kp N9   &kp N0         &kp EQUAL
&kp TAB    &kp Q       &kp W   &kp E     &kp R      &kp T                          &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                 &kp Y   &kp U   &kp I      &kp O    &kp P          &kp MINUS
&kp CAPS   &kp A       &kp S   &kp D     &kp F      &kp G       &lt SCROLL SPACE   &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &kp LBKT     &kp H   &kp J   &kp K      &kp L    &kp SEMI       &kp SQT
&kp LSHFT  &kp Z       &kp X   &kp C     &kp V      &kp B       &mkp RCLK          &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp RBKT     &kp N   &kp M   &kp COMMA  &kp DOT  &kp RS(FSLH)   &kp FSLH
&kp LCTRL  &kp C_MUTE          &kp LALT  &kp LGUI   &lt RAISE SPACE  &mkp LCLK                                                         &lt LOWER RET  &kp BSPC                                       &lt ADJUST SPACE
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&EC11_scroll>;
            bindings = <
&to_layer_0 ESC     &to_layer_0 N1  &to_layer_0 N2  &to_layer_0 N3  &to_layer_0 N4  &to_layer_0 N5                     &trans  &trans  &trans  &trans                     &to_layer_0 N6   &to_layer_0 N7  &to_layer_0 N8  &to_layer_0 N9      &to_layer_0 N0     &to_layer_0 EQUAL
&to_layer_0 TAB     &to_layer_0 Q   &to_layer_0 W   &to_layer_0 E   &to_layer_0 R   &to_layer_0 T                      &trans  &trans  &trans  &trans                     &to_layer_0 Y    &to_layer_0 U   &to_layer_0 I   &to_layer_0 O       &to_layer_0 P      &to_layer_0 MINUS
&to_layer_0 CAPS    &to_layer_0 A   &mkp RCLK       &mkp MCLK       &mkp LCLK       &msc SCRL_UP    &msc SCRL_LEFT     &trans  &trans  &trans  &trans    &msc SCRL_LEFT   &msc SCRL_UP     &mkp LCLK       &mkp MCLK       &mkp RCLK           &to_layer_0 SEMI   &to_layer_0 SQT
&to_layer_0 LSHIFT  &to_layer_0 Z   &to_layer_0 X   &mkp MB4        &mkp MB5        &msc SCRL_DOWN  &msc SCRL_RIGHT    &trans  &trans  &trans  &trans    &msc SCRL_RIGHT  &msc SCRL_DOWN   &mkp MB4        &mkp MB5        &to_layer_0 DOT     &to_layer_0 FSLH   &to_layer_0 FSLH
&trans              &trans                          &trans          &trans          &trans          &trans                                               &trans           &trans                                                                                &trans
            >;
        };

        lower_layer {
            display-name = "Lower";
            sensor-bindings = <&rsr_trans>;
            bindings = <
&trans  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)               &trans  &trans  &trans  &trans            &kp RS(N6)  &kp RS(N7)  &kp RS(N8)  &kp RS(N9)  &kp RS(N0)  &kp MINUS
&trans  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)               &trans  &trans  &trans  &trans            &kp RC(N6)  &kp RC(N7)  &kp RC(N8)  &kp RC(N9)  &kp RC(N0)  &kp EQUAL
&trans  &kp LEFT    &kp DOWN    &kp RIGHT   &trans      &kp LANG1   &trans       &trans  &trans  &trans  &trans    &trans  &trans      &trans      &trans      &trans      &trans      &trans
&trans  &kp LEFT    &kp DOWN    &kp RIGHT   &trans      &kp LANG2   &trans       &trans  &trans  &trans  &trans    &trans  &trans      &trans      &trans      &trans      &trans      &trans
&trans  &trans                  &trans      &trans      &trans      &trans                                         &trans  &trans                                                          &studio_unlock
            >;
        };

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&rsr_trans>;
            bindings = <
&trans  &kp F14     &kp F15     &kp F3      &kp F4      &kp F5                   &trans  &trans  &trans  &trans            &kp F6      &kp F7      &kp F8      &kp K_VOL_DN  &kp K_VOL_UP  &kp K_MUTE
&trans  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)               &trans  &trans  &trans  &trans            &kp RS(N6)  &kp RS(N7)  &kp RS(N8)  &kp RS(N9)    &kp RS(N0)    &trans
&trans  &kp LEFT    &kp UP      &kp RIGHT   &none       &kp LANG2   &none        &trans  &trans  &trans  &trans    &none  &trans      &kp LEFT    &kp DOWN    &kp RIGHT     &trans        &none
&trans  &kp LEFT    &kp DOWN    &kp RIGHT   &none       &kp LANG2   &none        &trans  &trans  &trans  &trans    &none  &none       &none       &none       &none         &none         &none
&trans  &none                   &trans      &trans      &trans      &trans                                         &trans  &trans                                                              &trans
            >;
        };

        scroll_layer {
            display-name = "Scroll";
            sensor-bindings = <&rsr_trans>;
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans               &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans               &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans  &trans  &trans  &trans                                         &trans  &trans                                  &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            sensor-bindings = <&rsr_trans>;
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4            &trans  &trans  &trans  &trans              &bt BT_CLR_ALL  &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none                   &trans  &trans  &trans  &trans              &bt BT_CLR      &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_bat  &out OUT_TOG    &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_con  &studio_unlock  &none  &none  &none  &none  &none
&trans  &kp C_MUTE                  &trans        &trans        &trans        &trans                                      &trans    &kp DEL                                     &trans
            >;
        };

        // DYA Studioでレイヤーを追加するための予備
        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
    };
};
